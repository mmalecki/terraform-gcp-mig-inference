{
  "variables": {
    "build_prefix": "",
    "docker_version": "",
    "cuda_drivers_version": "",
    "node_major_version": "24",
    "image_version": "",
    "gcp_project_id": "",
    "ops_agent_version": "2.72.0~ubuntu26.04",
    "dcgm_version": "1:4.7.0-2",
    "dcgm_exporter_version": "4.8.4.3955-1"
  },
  "builders": [
    {
      "type": "googlecompute",
      "project_id": "{{user `gcp_project_id`}}",
      "source_image": "ubuntu-2604-resolute-amd64-v20260527",
      "image_name": "{{user `build_prefix`}}llm-cuda-{{user `image_version` | clean_resource_name}}",
      "instance_name": "{{user `build_prefix`}}llm-cuda-{{user `image_version` | clean_resource_name}}",
      "ssh_username": "ubuntu",
      "zone": "{{user `gcp_zone`}}",
      "disk_size": 50
    }
  ],
  "provisioners": [
    {
      "type": "shell",
      "inline": ["cloud-init status --long --wait"]
    },
    {
      "type": "shell",
      "inline": ["sudo apt update -y && sudo apt upgrade -y && sudo apt install -y zfsutils-linux nvitop"]
    },
    {
      "type": "shell",
      "scripts": [
        "provisioners/kernel/kernel-tuning.sh"
      ]
    },
    {
      "type": "shell",
      "scripts": ["provisioners/install-docker.sh"],
      "environment_vars": ["DOCKER_VERSION={{user `docker_version`}}"]
    },
    {
      "type": "shell",
      "environment_vars": ["NODE_MAJOR_VERSION={{user `node_major_version`}}"],
      "script": "provisioners/install-nodejs.sh"
    },
    {
      "type": "shell",
      "environment_vars": ["CUDA_DRIVERS_VERSION={{user `cuda_drivers_version`}}"],
      "script": "provisioners/cuda.sh"
    },
    {
      "type": "shell",
      "script": "provisioners/install-nvidia-container-toolkit.sh"
    },
    {
      "type": "shell",
      "script": "provisioners/configure-docker-logging.sh"
    },
    {
      "type": "shell",
      "environment_vars": [
        "DCGM_VERSION={{user `dcgm_version`}}",
        "DCGM_EXPORTER_VERSION={{user `dcgm_exporter_version`}}"
      ],
      "execute_command": "chmod +x {{ .Path }}; {{ .Vars }} sudo -E bash '{{ .Path }}'",
      "script": "provisioners/install-dcgm.sh"
    },
    {
      "type": "shell",
      "inline": [
        "sudo systemctl start docker.service",
        "sudo docker pull vllm/vllm-openai:latest",
        "sudo docker pull ghcr.io/ggml-org/llama.cpp:server-cuda"
      ]
    },
    {
      "type": "shell",
      "environment_vars": ["OPS_AGENT_VERSION={{user `ops_agent_version`}}"],
      "execute_command": "chmod +x {{ .Path }}; {{ .Vars }} sudo -E bash '{{ .Path }}'",
      "script": "provisioners/install-ops-agent.sh"
    }
  ]
}
